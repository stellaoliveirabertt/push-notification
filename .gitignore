# IDEs and Editors
.vscode/ # Configurações do VS Code (opcional, pode querer versionar settings.json)
.idea/ # IntelliJ IDEA
.history/ # VS Code extension

# OS generated files
.DS_Store # macOS
Thumbs.db # Windows
ehthumbs.db # Windows
.directory # Linux (KDE)

# Environment variables
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local

# Firebase (se você usa Firebase no frontend e tem arquivos de configuração)
firebase-debug.log
firebase-key.json # NUNCA comitar chaves privadas!
firebase-adminsdk*.json # NUNCA comitar chaves de admin!
src/environments/firebase-config.ts # Exemplo para arquivos de config em TS

