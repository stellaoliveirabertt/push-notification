# Runtime and build artifacts
build/
dist/
.cache/
.eslintcache
.parcel-cache/ # Se você usa Parcel para algo
.rollup.cache/ # Se você usa Rollup para algo
.next/ # Se você usa Next.js
.nuxt/ # Se você usa Nuxt.js
.svelte-kit/ # Se você usa SvelteKit

# Vite specific
.vite/
